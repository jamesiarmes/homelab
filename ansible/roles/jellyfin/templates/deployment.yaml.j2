apiVersion: apps/v1
kind: Deployment
metadata:
  name: jellyfin
  namespace: media
  labels:
    app.kubernetes.io/instance: jellyfin
    app.kubernetes.io/name: jellyfin
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/instance: jellyfin
      app.kubernetes.io/name: jellyfin
  template:
    metadata:
      labels:
        app.kubernetes.io/instance: jellyfin
        app.kubernetes.io/name: jellyfin
      annotations:
        k8s.v1.cni.cncf.io/networks: kube-system/macvlan-conf
    spec:
      securityContext:
        fsGroup: 65534
      containers:
        - name: jellyfin
          image: "jellyfin/jellyfin:{{ jellyfin_version }}"
          imagePullPolicy: IfNotPresent
          {% if jellyfin_published_url -%}
          env:
            - name: JELLYFIN_PublishedServerUrl
              value: http://{{ jellyfin_published_url }}:{{ jellyfin_lb_port }}
          {% endif -%}
          ports:
            # Main web interface.
            - name: http
              containerPort: 8096
              protocol: TCP
            # Used for DLNA.
            - name: ssdp
              containerPort: 1900
              protocol: UDP
            # Used for service discovery.
            - name: discovery
              containerPort: 7359
              protocol: UDP
          resources:
            requests:
              cpu: "500m"
              memory: "2Gi"
            limits:
              cpu: "2000m"
              memory: "4Gi"
          volumeMounts:
            - name: config
              mountPath: /config
            - name: transcode
              mountPath: /config/transcodes
            - name: media-movies
              mountPath: /media/movies
            - name: media-tv
              mountPath: /media/tv
      volumes:
        - name: config
          persistentVolumeClaim:
            claimName: jellyfin-config
        - name: transcode
          emptyDir: {}
        - name: media-movies
          persistentVolumeClaim:
            claimName: jellyfin-movies-pvc
        - name: media-tv
          persistentVolumeClaim:
            claimName: jellyfin-tv-pvc
