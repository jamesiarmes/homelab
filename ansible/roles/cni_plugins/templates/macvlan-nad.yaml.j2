apiVersion: "k8s.cni.cncf.io/v1"
kind: NetworkAttachmentDefinition
metadata:
  name: macvlan-conf
  namespace: kube-system
spec:
  config: |
    {
      "cniVersion": "0.3.1",
      "type": "macvlan",
      "name": "macvlan-conf",
      "master": "{{ cni_plugins_macvlan_interface }}",
      "mode": "bridge",
      "mtu": 1500,
      "ipam": {
        "type": "host-local",
        "subnet": "{{ cni_plugins_subnet_cidr }}",
        "routes": [{"dst": "224.0.0.0/4"}]
      },
      "gateway": "{{ cni_plugins_macvlan_gateway }}"
    }
